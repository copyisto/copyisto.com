---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import AnnotatedImage from '@/components/primitives/AnnotatedImage.astro';
import Frame from '@/components/primitives/Frame.astro';
import ScoreReveal from './ScoreReveal.astro';
import { copyFor } from '@/content';
import { routesFor } from '@/lib/routes';

const { howItWorks } = copyFor(Astro.currentLocale);
const { ids } = routesFor(Astro.currentLocale);
---

<section class="band how gutter" id={ids.howItWorks}>
  <Eyebrow class="how-eyebrow">{howItWorks.eyebrow}</Eyebrow>
  <h2 class="display how-title">{howItWorks.title}</h2>

  <div class="how-steps">
    {howItWorks.steps.map((step) => (
      <article class:list={['step', step.reversed && 'step-reversed', step.wide && 'step-wide']}>
        <div class="step-copy">
          <span class="ornament ornament-lg">{step.number}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-body">{step.body}</p>
        </div>
        <Frame label={step.frameLabel}>
          {step.image ? <AnnotatedImage {...step.image} /> : <ScoreReveal />}
        </Frame>
      </article>
    ))}
  </div>
</section>

<style>
  .how {
    padding-block: var(--space-section);
    scroll-margin-top: 72px;
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.how-eyebrow) {
    margin-bottom: 24px;
  }

  .how-title {
    max-width: 18ch;
    margin-bottom: var(--space-stack);
  }

  .how-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-stack);
  }

  /* The artwork takes the wider column so the score detail stays legible. */
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-items: center;
    gap: var(--space-column);
  }

  .step-reversed {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }

  .step-copy {
    min-width: 0;
  }

  /* Step two puts the artwork first. */
  .step-reversed .step-copy {
    order: 2;
  }

  @media (max-width: 860px) {
    .step,
    .step-reversed {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--gap-2xl);
    }

    .step-reversed .step-copy {
      order: initial;
    }
  }

  .step-title {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-size: clamp(23px, 2.1vw, 30px);
    font-weight: 500;
    line-height: 1.2;
  }

  .step-body {
    max-width: 46ch;
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.68;
    text-wrap: pretty;
  }

  /* The finale: copy in two columns above, the score across the full width. */
  .step-wide {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-column-sm);
  }

  .step-wide .step-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--space-column);
    align-items: end;
  }

  .step-wide .step-body {
    grid-row: 1 / span 2;
    grid-column: 2;
  }

  /* Full width reads as too loud on large screens; cap it and keep it centred. */
  .step-wide > :global(.frame) {
    justify-self: center;
    width: 100%;
    max-width: 1040px;
  }

  @media (max-width: 860px) {
    .step-wide .step-copy {
      display: block;
    }
  }
</style>
