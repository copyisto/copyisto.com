---
import Button from '@/components/primitives/Button.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import { hero } from '@/content/landing';
import { cta } from '@/content/site';
// Inlined rather than served as <img> so the page stylesheet can reach
// #copyisto-mark and animate it. Vite's ?raw keeps it a build-time read.
import heroSvg from '@/assets/hero-illustration.svg?raw';
---

<section class="hero gutter" id="top">
  <div class="hero-copy">
    <h1 class="hero-title">
      {hero.titleLead} <em class="hero-title-script">{hero.titleScript}</em>
    </h1>
    <p class="hero-subtitle">{hero.subtitle}</p>
    <p class="hero-lead">{hero.lead}</p>
    <Eyebrow class="hero-eyebrow">{hero.eyebrow}</Eyebrow>
    <div class="hero-actions">
      <Button
        href={cta.formHref}
        variant="primary"
        size="lg"
        data-track="form_cta_clicked"
        data-track-location="hero"
      >
        {cta.donate}
      </Button>
      <span class="hero-note">{hero.ctaNote}</span>
    </div>
  </div>

  <div class="hero-art">
    <div class="hero-art-frame" role="img" aria-label={hero.illustrationAlt} set:html={heroSvg} />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    align-items: center;
    gap: var(--space-column);
    padding-top: clamp(12px, 1.6vw, 22px);
    padding-bottom: clamp(40px, 6vw, 88px);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-title {
    margin: 0 0 28px;
    font-family: var(--font-serif);
    font-size: clamp(38px, 4.6vw, 68px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.06;
    text-wrap: pretty;
  }

  .hero-title-script {
    font-family: var(--font-script);
    font-size: 1.14em;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.005em;
  }

  .hero-subtitle {
    max-width: 26ch;
    margin: 0 0 24px;
    color: var(--color-muted-strong);
    font-family: var(--font-serif);
    font-size: clamp(27px, 3.3vw, 48px);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.18;
    text-wrap: pretty;
  }

  .hero-lead {
    max-width: 56ch;
    margin: 0 0 36px;
    color: var(--color-muted);
    font-size: clamp(17px, 1.35vw, 19.5px);
    line-height: 1.62;
    text-wrap: pretty;
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.hero-eyebrow) {
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-xs);
  }

  .hero-note {
    color: var(--color-muted);
    font-size: var(--text-meta);
    letter-spacing: 0.01em;
  }

  .hero-art {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .hero-art-frame {
    width: 100%;
    max-width: 620px;
  }

  .hero-art-frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The mark that blinks out and springs back, ported from the design's
     WAAPI keyframes. Runs only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-art-frame :global(#copyisto-mark) {
      transform-box: fill-box;
      transform-origin: center;
      animation: copyisto-mark-pop 5.2s cubic-bezier(0.34, 1.3, 0.64, 1) infinite;
    }
  }

  @keyframes copyisto-mark-pop {
    0%,
    40% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }

    52% {
      opacity: 0;
      transform: scale(1.06) rotate(0deg);
    }

    62% {
      opacity: 0;
      transform: scale(0.55) rotate(-9deg);
    }

    78% {
      opacity: 1;
      transform: scale(1.14) rotate(3deg);
    }

    88%,
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
</style>
