---
import Button from '@/components/primitives/Button.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import { hero } from '@/content/landing';
import { cta } from '@/content/site';
---

<section class="hero gutter" id="top">
  <div class="hero-copy">
    <h1 class="hero-title">
      {hero.titleLead} <em class="hero-title-script">{hero.titleScript}</em>
    </h1>
    <p class="hero-subtitle">{hero.subtitle}</p>
    <p class="hero-lead">{hero.lead}</p>
    <Eyebrow class="hero-eyebrow">{hero.eyebrow}</Eyebrow>
    <div class="hero-actions">
      <Button
        href={cta.formHref}
        variant="primary"
        size="lg"
        data-track="form_cta_clicked"
        data-track-location="hero"
      >
        {cta.donate}
      </Button>
      <span class="hero-note">{hero.ctaNote}</span>
    </div>
  </div>

  <div class="hero-art">
    <img
      class="hero-art-frame"
      src="/assets/hero-illustration.svg"
      alt={hero.illustrationAlt}
      width="1024"
      height="1024"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    align-items: center;
    gap: var(--space-column);
    padding-top: clamp(12px, 1.6vw, 22px);
    padding-bottom: clamp(40px, 6vw, 88px);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-title {
    margin: 0 0 28px;
    font-family: var(--font-serif);
    font-size: clamp(38px, 4.6vw, 68px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.06;
    text-wrap: pretty;
  }

  .hero-title-script {
    font-family: var(--font-script);
    font-size: 1.14em;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.005em;
  }

  .hero-subtitle {
    max-width: 26ch;
    margin: 0 0 24px;
    color: var(--color-muted-strong);
    font-family: var(--font-serif);
    font-size: clamp(27px, 3.3vw, 48px);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.18;
    text-wrap: pretty;
  }

  .hero-lead {
    max-width: 56ch;
    margin: 0 0 36px;
    color: var(--color-muted);
    font-size: clamp(17px, 1.35vw, 19.5px);
    line-height: 1.62;
    text-wrap: pretty;
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.hero-eyebrow) {
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-xs);
  }

  .hero-note {
    color: var(--color-muted);
    font-size: var(--text-meta);
    letter-spacing: 0.01em;
  }

  .hero-art {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .hero-art-frame {
    display: block;
    width: 100%;
    max-width: 620px;
    height: auto;
  }
</style>
