---
import { copyFor } from '@/content';

const { problem } = copyFor(Astro.currentLocale);
---

<div class="perforation" aria-hidden="true"></div>

<section class="problem gutter" id="problem">
  <div class="problem-row">
    <div>
      <h2 class="problem-title">{problem.title}</h2>
      <p class="copy problem-body">{problem.body}</p>
    </div>
    <div class="problem-art" aria-hidden="true">
      <img src="/assets/bg-a-program.svg" alt="" />
    </div>
  </div>

  <figure class="problem-quote">
    <blockquote class="problem-quote-text">{problem.quote}</blockquote>
    <figcaption class="problem-quote-caption">{problem.quoteCaption}</figcaption>
  </figure>

  <div class="problem-row problem-row-reversed">
    <div class="problem-art" aria-hidden="true">
      <img src="/assets/bg-b-czas.svg" alt="" />
    </div>
    <p class="copy problem-closing">{problem.closing}</p>
  </div>
</section>

<style>
  /* A stave: five 1px lines 6px apart, so 4 × 6px + 1px tall. */
  .perforation {
    height: 25px;
    opacity: 0.7;
    background: repeating-linear-gradient(
      to bottom,
      var(--color-ink-22) 0 1px,
      transparent 1px 6px
    );
  }

  .problem {
    position: relative;
    padding-block: clamp(44px, 6vw, 88px);
    scroll-margin-top: 80px;
  }

  /* Both illustrations sit in flow beside their copy, so they can never
     overlap the text at any width. */
  .problem-row {
    display: grid;
    grid-template-columns: minmax(0, 56ch) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-column-sm);
  }

  .problem-row-reversed {
    grid-template-columns: minmax(0, 1fr) minmax(0, 56ch);
  }

  .problem-art {
    justify-self: center;
    width: 100%;
    max-width: 540px;
    pointer-events: none;
  }

  .problem-art img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Below 840px the artwork would squeeze the text, as in the design. */
  @media (max-width: 840px) {
    .problem-art {
      display: none;
    }

    .problem-row,
    .problem-row-reversed {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .problem-title {
    max-width: 17ch;
    margin: 0 0 32px;
    font-family: var(--font-serif);
    font-size: clamp(30px, 3.4vw, 50px);
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.12;
    text-wrap: pretty;
  }

  .problem-quote {
    position: relative;
    margin: clamp(36px, 4.5vw, 64px) 0;
    padding-block: var(--space-card-sm);
    border-top: 1px solid var(--color-rule-18);
    border-bottom: 1px solid var(--color-rule-18);
    text-align: center;
  }

  .problem-quote-text {
    margin: 0;
    color: var(--color-rust);
    font-family: var(--font-serif);
    font-size: clamp(26px, 3.2vw, 44px);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.22;
    text-wrap: balance;
  }

  .problem-quote-caption {
    margin-top: 18px;
    color: var(--color-muted);
    font-size: var(--text-note);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
</style>
