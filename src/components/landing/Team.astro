---
import { Image } from 'astro:assets';
import { team, teamStatement } from '@/content/team';
---

<section class="band team gutter" id="zespol">
  <h2 class="display team-title">Zespół Copyisto</h2>

  <div class="team-grid">
    {team.map((member) => (
      <div class="team-member">
        {member.photo ? (
          <Image
            class="team-avatar team-photo"
            src={member.photo}
            alt={`${member.name} - zdjęcie`}
            widths={[160, 320, 480]}
            sizes="160px"
            quality={90}
            loading="lazy"
          />
        ) : (
          <div class="team-avatar" aria-hidden="true">
            Placeholder
            <br />
            zdjęcie
          </div>
        )}
        <div class="team-member-copy">
          <h3 class="team-name">{member.name}</h3>
          {member.url && (
            <a class="team-link" href={member.url} target="_blank" rel="noopener">
              {new URL(member.url).hostname} ↗
            </a>
          )}
          <p class:list={['team-bio', member.emphasised && 'team-bio-quoted']}>{member.bio}</p>
        </div>
      </div>
    ))}
  </div>

  <p class="team-statement">{teamStatement}</p>
</section>

<style>
  .team {
    padding-block: var(--space-section);
    scroll-margin-top: 72px;
  }

  .team-title {
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(28px, 4vw, 56px);
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .team-member {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--gap-lg);
    min-width: 0;
  }

  /* Wraps under the photo once the column can't fit ~200px of text beside it. */
  .team-member-copy {
    flex: 1 1 200px;
    min-width: 0;
  }

  .team-avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 160px;
    height: 160px;
    padding: 8px;
    border: 1px solid var(--color-rule-30);
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-rust);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
  }

  .team-photo {
    padding: 0;
    object-fit: cover;
  }

  .team-name {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: 25px;
    font-weight: 500;
  }

  .team-link {
    display: inline-block;
    margin-bottom: 10px;
    font-size: var(--text-sm);
  }

  .team-bio {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .team-bio-quoted {
    padding-left: 12px;
    border-left: 2px solid var(--color-rust);
    color: var(--color-muted);
    font-style: italic;
  }

  .team-statement {
    max-width: 52ch;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.8vw, 25px);
    font-style: italic;
    line-height: 1.45;
    text-wrap: pretty;
  }
</style>
