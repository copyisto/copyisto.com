---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import HelpCta from './HelpCta.astro';
import { why } from '@/content/landing';
---

<section class="why gutter" id="dlaczego">
  <div class="why-shell">
    <div class="why-copy">
      <Eyebrow class="why-eyebrow">{why.eyebrow}</Eyebrow>
      <h2 class="display why-title">{why.title}</h2>
      <p class="why-body">{why.body}</p>
    </div>

    <div class="why-art">
      <img
        src={why.illustration.src}
        alt={why.illustration.alt}
        width="1063"
        height="635"
        loading="lazy"
      />
    </div>
  </div>

  {/* The ask follows the argument: why notebooks matter, then how to send one. */}
  <div class="why-shell why-help">
    <HelpCta />
  </div>
</section>

<style>
  .why {
    padding-block: var(--space-section);
    scroll-margin-top: 72px;
  }

  .why-shell {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    align-items: center;
    gap: var(--space-column);
  }

  .why-copy,
  .why-art {
    min-width: 0;
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.why-eyebrow) {
    margin-bottom: 24px;
  }

  .why-art img {
    display: block;
    width: 100%;
    height: auto;
  }

  .why-title {
    margin-bottom: 28px;
  }

  .why-body {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.72;
    text-wrap: pretty;
  }

  .why-help {
    display: block;
    margin-top: var(--space-stack);
  }
</style>
