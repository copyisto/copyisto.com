---
import Button from '@/components/primitives/Button.astro';
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import { copyFor } from '@/content';
import { icons } from '@/lib/icons';
import { mailto, social } from '@/lib/routes';

const { local, remote } = copyFor(Astro.currentLocale).collection;

// Direct-message channels show only once their username is set.
const channels = [
  { href: social.instagram, label: local.instagram, icon: icons.instagram, channel: 'instagram' },
  { href: social.messenger, label: local.messenger, icon: icons.messenger, channel: 'messenger' },
].filter((c) => c.href);
---

<section class="collection gutter" id="zbiorka">
  <div class="collection-grid">
    <div class="collection-local">
      <Eyebrow class="collection-eyebrow">{local.eyebrow}</Eyebrow>
      <h2 class="display-sm collection-title">{local.title}</h2>
      <p class="collection-body">{local.body}</p>
      <div class="collection-actions">
        <Button
          href={mailto}
          variant="primary"
          size="md"
          data-track="email_clicked"
          data-track-location="collection_local"
        >
          <span class="collection-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons.email} />
            </svg>
            {local.email}
          </span>
        </Button>
        {channels.map((c) => (
          <Button
            href={c.href}
            variant="outline"
            size="md"
            data-track="dm_clicked"
            data-track-channel={c.channel}
            data-track-location="collection_local"
          >
            <span class="collection-btn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={c.icon} />
              </svg>
              {c.label}
            </span>
          </Button>
        ))}
      </div>
    </div>

    <aside class="collection-remote">
      <p class="collection-remote-eyebrow">{remote.eyebrow}</p>
      <h3 class="collection-remote-title">{remote.title}</h3>
      <p class="collection-remote-body">
        {remote.body}{' '}
        <a
          href={mailto}
          class="prose-link"
          data-track="email_clicked"
          data-track-location="collection_remote"
        >
          {remote.email}
        </a>
      </p>
    </aside>
  </div>
</section>

<style>
  .collection {
    scroll-margin-top: 24px;
  }

  /* Wrocław is the only way in this month, so it takes the lead column and
     the remote note sits beside it as an aside. */
  .collection-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--gap-2xl);
  }

  @media (min-width: 900px) {
    .collection-grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .collection-local {
    min-width: 0;
    padding: var(--space-card);
    border: 1px solid var(--color-rule-30);
    background: var(--color-bright);
    box-shadow: 5px 6px 0 var(--color-ink-12);
  }

  .collection-remote {
    min-width: 0;
    padding: var(--space-card-sm);
    border: 1px dashed var(--color-rule-25);
  }

  .collection-remote-eyebrow {
    margin: 0 0 10px;
    color: var(--color-muted);
    font-size: var(--text-note);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .collection-remote-title {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.35;
  }

  .collection-remote-body {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-base);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.collection-eyebrow) {
    margin-bottom: 16px;
  }

  .collection-title {
    margin-bottom: 12px;
  }

  .collection-body {
    max-width: 46ch;
    margin: 0 0 26px;
    color: var(--color-ink-soft);
    font-size: var(--text-body);
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* E-mail leads on its own row. The direct-message buttons share the next at
     equal widths only while both labels fit on one line, and stack otherwise,
     so a wrapped label never leaves the pair at mismatched heights. */
  .collection-actions {
    display: grid;

    /* 240px holds "Napisz na Messengerze" on one line at the trimmed padding. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--gap-sm);
  }

  /* :global because the buttons are Button components, outside this scope. */
  .collection-actions > :global(:first-child) {
    grid-column: 1 / -1;
  }

  /* Trimmed from the md button's 26px so the pair fits side by side sooner. */
  .collection-actions :global(.btn.btn-md) {
    padding-inline: 18px;
  }

  /* Labels never wrap, so paired buttons keep one height. */
  .collection-btn {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .collection-btn svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: currentcolor;
  }
</style>
