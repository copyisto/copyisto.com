---
import Eyebrow from '@/components/primitives/Eyebrow.astro';
import { copyFor } from '@/content';

const { formIntro } = copyFor(Astro.currentLocale);
---

<div class="intro">
  <Eyebrow class="intro-eyebrow">{formIntro.eyebrow}</Eyebrow>
  <h1 class="intro-title">
    {formIntro.titleLead} <em class="intro-title-script">{formIntro.titleScript}</em>
  </h1>
  <p class="intro-body">{formIntro.body}</p>

  <ol class="intro-steps">
    {formIntro.steps.map((step) => (
      <li class="intro-step">
        <span class="ornament ornament-sm intro-step-num">{step.number}</span>
        <div class="intro-step-copy">
          <strong class="intro-step-title">{step.title}</strong>
          <span class="intro-step-body">{step.body}</span>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .intro {
    min-width: 0;
  }

  /* :global because this class is handed to a child component, and a
     parent's scoped styles never reach a child's markup. */

  :global(.intro-eyebrow) {
    margin-bottom: 22px;
  }

  /* Wrocław is the first thing to read: the collection is in person only. */
  .intro :global(.intro-eyebrow .eyebrow-label) {
    font-family: var(--font-script);
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 400;
    line-height: 1.2;
  }

  .intro-title {
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.08;
    text-wrap: pretty;
  }

  /* Kept on one line: the script phrase reads as one word. */
  .intro-title-script {
    font-family: var(--font-script);
    font-style: italic;
    white-space: nowrap;
  }

  .intro-body {
    max-width: 52ch;
    margin: 0 0 30px;
    color: var(--color-ink-soft);
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.66;
    text-wrap: pretty;
  }

  .intro-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 22px 36px;
    padding-top: 26px;
    border-top: 1px solid var(--color-rule-18);
  }

  .intro-step {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-md);
  }

  .intro-step-num {
    flex-shrink: 0;
    min-width: 32px;
  }

  .intro-step-copy {
    min-width: 0;
  }

  .intro-step-title {
    display: block;
    margin-bottom: 3px;
    font-weight: 600;
  }

  .intro-step-body {
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }
</style>
