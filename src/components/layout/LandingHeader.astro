---
import Button from '@/components/primitives/Button.astro';
import Logo from './Logo.astro';
import MobileNav from './MobileNav.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { copyFor } from '@/content';
import { routesFor } from '@/lib/routes';

const { cta, nav, primaryNav } = copyFor(Astro.currentLocale);
const routes = routesFor(Astro.currentLocale);
---

<header class="landing-header gutter">
  <Logo href={routes.home} collapsible />
  <nav class="landing-nav" aria-label={nav.label}>
    <div class="landing-nav-links">
      {primaryNav.map((item) =>
        item.soon ? (
          <span class="nav-soon">
            {item.label}
            <span class="nav-soon-badge">{nav.soon}</span>
          </span>
        ) : (
          <a href={item.href} class="nav-link">
            {item.label}
          </a>
        ),
      )}
    </div>
    <LanguageSwitch />
    <Button
      href={cta.formHref}
      variant="solid"
      size="xs"
      compact
      data-track="form_cta_clicked"
      data-track-location="landing_header"
    >
      {cta.openForm}
    </Button>
    <MobileNav />
  </nav>
</header>

<style>
  .landing-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-2xl);
    padding-block: 16px;
    border-bottom: 1px solid var(--color-rule);
  }

  /* The frosted glass lives on a pseudo-element: backdrop-filter on the header
     itself would make it the containing block for the mobile drawer's fixed
     scrim, shrinking the scrim to the header's height. */
  .landing-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-paper-88);
    backdrop-filter: blur(8px);
  }

  .landing-nav,
  .landing-nav-links {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(16px, 2.2vw, 32px);
  }

  .nav-link {
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-link:hover {
    border-bottom-color: var(--color-rust);
    color: var(--color-rust);
    text-decoration: none;
  }

  .nav-soon {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--color-faint);
    cursor: default;
    font-size: var(--text-base);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Below 1090px the links move into the drawer. */
  @media (max-width: 1089px) {
    .landing-nav-links {
      display: none;
    }
  }
</style>
