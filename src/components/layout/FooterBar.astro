---
import { copyFor } from '@/content';
import { icons } from '@/lib/icons';
import { profiles } from '@/lib/routes';

interface Props {
  note: string;
}
const { note } = Astro.props;
const { footerNav, site } = copyFor(Astro.currentLocale);

// Each profile shows only once its URL is set.
const socials = [
  { href: profiles.facebook, label: 'Facebook', icon: icons.facebook, network: 'facebook' },
  { href: profiles.instagram, label: 'Instagram', icon: icons.instagram, network: 'instagram' },
  { href: profiles.twitter, label: 'X (Twitter)', icon: icons.x, network: 'twitter' },
].filter((s) => s.href);
---

<div class="footer-bar">
  <span class="footer-word">{site.name}</span>
  <div class="footer-links">
    <a href={footerNav.privacy.href} class="footer-link">
      {footerNav.privacy.label}
    </a>
    <button type="button" class="footer-link footer-link-button" data-consent-open>
      {footerNav.cookieSettings}
    </button>
    {socials.length > 0 && (
      <ul class="footer-socials">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="footer-social"
              target="_blank"
              rel="noopener"
              aria-label={s.label}
              title={s.label}
              data-track="social_clicked"
              data-track-network={s.network}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={s.icon} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    )}
    <span class="footer-note">{note}</span>
  </div>
</div>

<style>
  .footer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
  }

  .footer-word {
    color: var(--color-dark-fg-strong);
    font-family: var(--font-serif);
    font-size: 19px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-xl);
  }

  .footer-link {
    color: var(--color-dark-fg-soft);
    font-size: var(--text-meta);
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-dark-fg-strong);
    text-decoration: none;
  }

  .footer-link-button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    font-size: var(--text-meta);
  }

  .footer-socials {
    display: flex;
    gap: var(--gap-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-social {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--color-dark-fg-soft);
  }

  .footer-social:hover {
    color: var(--color-dark-fg-strong);
  }

  .footer-social svg {
    width: 18px;
    height: 18px;
    fill: currentcolor;
  }

  .footer-note {
    color: var(--color-dark-fg-faint);
    font-size: var(--text-caption);
  }
</style>
