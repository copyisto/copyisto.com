---
import Logo from './Logo.astro';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  logoHref: string;
}
const { logoHref } = Astro.props;
---

<header class="page-header gutter">
  <Logo href={logoHref} collapsible />
  <div class="page-header-actions">
    <LanguageSwitch />
    <slot />
  </div>
</header>

<style>
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-2xl);
    padding-block: 16px;
    border-bottom: 1px solid var(--color-rule);
  }

  .page-header-actions {
    display: flex;
    align-items: center;
    gap: var(--gap-2xl);
  }
</style>
