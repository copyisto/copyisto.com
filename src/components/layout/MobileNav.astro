---
import { copyFor } from '@/content';

const { nav, primaryNav } = copyFor(Astro.currentLocale);

/**
 * Navigation for viewports below the design's 1090px cut-off.
 *
 * The source design simply hides the links there, leaving phones with no way
 * to reach the page sections; this restores them behind a standard drawer.
 */
---

<div class="nav-toggle-wrap" data-drawer>
  <button
    type="button"
    class="nav-toggle"
    aria-expanded="false"
    aria-label={nav.openMenu}
    data-label-open={nav.openMenu}
    data-label-close={nav.closeMenu}
    data-drawer-toggle
  >
    <span class="nav-toggle-icon" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>

  <div class="nav-scrim" data-drawer-scrim hidden></div>

  <div
    class="nav-drawer"
    role="dialog"
    aria-modal="true"
    aria-label={nav.menu}
    data-drawer-panel
    hidden
  >
    <nav class="nav-drawer-links">
      {primaryNav.map((item) =>
        item.soon ? (
          <span class="nav-drawer-soon">
            {item.label}
            <span class="nav-soon-badge">{nav.soon}</span>
          </span>
        ) : (
          <a href={item.href} class="nav-drawer-link" data-drawer-link>
            {item.label}
          </a>
        ),
      )}
    </nav>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-drawer]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-drawer-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-drawer-panel]')!;
    const scrim = root.querySelector<HTMLElement>('[data-drawer-scrim]')!;
    const icon = root.querySelector<HTMLElement>('.nav-toggle-icon')!;

    const focusable = () =>
      [...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input')].filter(
        (el) => el.offsetParent !== null,
      );

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      scrim.hidden = !open;
      icon.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '',
      );
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) focusable()[0]?.focus();
    };

    toggle.addEventListener('click', () => setOpen(Boolean(panel.hidden)));
    scrim.addEventListener('click', () => setOpen(false));
    root
      .querySelectorAll('[data-drawer-link]')
      .forEach((a) => a.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return;
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }
      if (event.key !== 'Tab') return;

      const items = focusable();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  /* The design drops the links below 1090px; the drawer takes over there. */
  @media (min-width: 1090px) {
    .nav-toggle-wrap {
      display: none;
    }
  }

  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-rule-35);
    border-radius: 2px;
    background: transparent;
    cursor: pointer;
    transition: border-color 140ms ease;
  }

  .nav-toggle:hover {
    border-color: var(--color-rust);
  }

  .nav-toggle-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }

  .nav-toggle-icon span {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: var(--color-ink);
    transition:
      transform 180ms ease,
      opacity 140ms ease;
  }

  .nav-toggle-icon span:nth-child(1) {
    top: 0;
  }

  .nav-toggle-icon span:nth-child(2) {
    top: 5.25px;
  }

  .nav-toggle-icon span:nth-child(3) {
    top: 10.5px;
  }

  .nav-toggle-icon.is-open span:nth-child(1) {
    transform: translateY(5.25px) rotate(45deg);
  }

  .nav-toggle-icon.is-open span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle-icon.is-open span:nth-child(3) {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  .nav-scrim {
    position: fixed;
    inset: 67px 0 0;
    z-index: 40;
    background: var(--color-ink-28);
  }

  .nav-drawer {
    position: fixed;
    top: 67px;
    left: 0;
    right: 0;
    z-index: 55;
    max-height: calc(100dvh - 67px);
    overflow-y: auto;
    padding: 20px var(--gutter) 28px;
    border-top: 1px solid var(--color-rule);
    background: var(--color-paper);
    box-shadow: 0 10px 0 var(--color-ink-04);
  }

  .nav-scrim[hidden],
  .nav-drawer[hidden] {
    display: none;
  }

  .nav-drawer-links {
    display: flex;
    flex-direction: column;
  }

  .nav-drawer-link,
  .nav-drawer-soon {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    padding-block: 14px;
    border-bottom: 1px solid var(--color-rule-18);
    font-size: var(--text-xl);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-drawer-link {
    color: var(--color-ink);
  }

  .nav-drawer-link:hover {
    color: var(--color-rust);
    text-decoration: none;
  }

  .nav-drawer-soon {
    color: var(--color-faint);
    cursor: default;
  }
</style>
