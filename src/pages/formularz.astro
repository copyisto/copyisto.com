---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PageFooter from '@/components/layout/PageFooter.astro';
import FormIntro from '@/components/formularz/FormIntro.astro';
import Collection from '@/components/formularz/Collection.astro';
import CreditsInfo from '@/components/formularz/CreditsInfo.astro';
import { copyFor } from '@/content';
import { routesFor } from '@/lib/routes';

const { formPage, site } = copyFor(Astro.currentLocale);
const routes = routesFor(Astro.currentLocale);
---

<Base title={formPage.title} description={formPage.description}>
  <div class="page">
    <PageHeader logoHref={routes.home}>
      <a href={routes.home} class="header-back">
        {formPage.back}
      </a>
    </PageHeader>

    <main class="page-main">
      <div class="form-intro-wrap gutter">
        <FormIntro />
      </div>
      <Collection />
      <CreditsInfo />
    </main>

    <PageFooter note={site.domain} />
  </div>
</Base>

<style>
  .form-intro-wrap {
    padding-top: var(--space-column);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .header-back {
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .header-back:hover {
    color: var(--color-rust);
    text-decoration: none;
  }

  /* The smallest phones can't fit the wordmark and the link on one line. */
  @media (max-width: 359px) {
    .header-back {
      white-space: normal;
      text-align: right;
    }
  }
</style>
